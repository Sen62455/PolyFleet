[Unit]
Description=PolyFleet managed sing-box VLESS Reality data plane
Documentation=https://github.com/Sen62455/PolyFleet
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/sing-box/hyfleet-reality.json
ConditionFileIsExecutable=/usr/bin/sing-box

[Service]
Type=simple
User=hyfleet-singbox
Group=hyfleet-singbox
WorkingDirectory=/var/lib/hyfleet-singbox
ExecStartPre=/usr/bin/test ! -L /usr/bin/sing-box
ExecStartPre=/usr/bin/sing-box check -c /etc/sing-box/hyfleet-reality.json
ExecStart=/usr/bin/sing-box run -c /etc/sing-box/hyfleet-reality.json
Restart=on-failure
RestartSec=3s
TimeoutStartSec=15s
TimeoutStopSec=15s
UMask=0027

AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProtectSystem=strict
ProcSubset=pid
ReadWritePaths=/var/lib/hyfleet-singbox
RemoveIPC=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
