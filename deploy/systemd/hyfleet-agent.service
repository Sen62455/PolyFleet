[Unit]
Description=PolyFleet node Agent (HyFleet-compatible runtime)
Documentation=https://github.com/Sen62455/PolyFleet
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hyfleet-agent
Group=hyfleet-agent
EnvironmentFile=-/etc/hyfleet/agent.env
EnvironmentFile=-/etc/hyfleet/hy2-stats.env
ExecStartPre=/usr/bin/test -r /proc/stat
ExecStartPre=/usr/bin/test -r /proc/meminfo
ExecStartPre=/usr/bin/test -r /proc/uptime
ExecStartPre=/usr/bin/test -r /proc/loadavg
ExecStartPre=/usr/bin/test -r /proc/diskstats
ExecStartPre=/usr/bin/test -r /proc/net/dev
ExecStart=/usr/local/bin/hyfleet-agent -config /etc/hyfleet/agent.yaml
Restart=always
RestartSec=3s
TimeoutStopSec=15s
UMask=0077

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=default
ProtectSystem=strict
ProcSubset=all
ReadWritePaths=/var/lib/hyfleet-agent
RemoveIPC=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
